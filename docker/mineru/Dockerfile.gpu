# Build the upstream MinerU base first from mineru/docker/china/Dockerfile or
# mineru/docker/global/Dockerfile, tagging it as mineru:latest.
FROM mineru:latest

# Keep curl available for the compose healthcheck when upstream base changes.
RUN if ! command -v curl >/dev/null 2>&1; then \
        apt-get update && \
        apt-get install -y --no-install-recommends curl && \
        apt-get clean && \
        rm -rf /var/lib/apt/lists/*; \
    fi

COPY patches/ /tmp/mineru-patches/
RUN python3 /tmp/mineru-patches/apply_title_aided_runtime_patch.py && \
    rm -rf /tmp/mineru-patches

EXPOSE 8000

# CRITICAL: Override vllm's ENTRYPOINT so CMD is executed directly.
# The official MinerU Dockerfile pre-bakes local models; keep local as default.
ENTRYPOINT ["/bin/bash", "-c", "export MINERU_MODEL_SOURCE=${MINERU_MODEL_SOURCE:-local} && exec \"$@\"", "--"]

# Backend selection is kept request-driven (form field `backend`) to support
# both `pipeline` (CPU-fallback) and `hybrid-auto-engine` (GPU) per request.
CMD ["mineru-api", "--host", "0.0.0.0", "--port", "8000"]
